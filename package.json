{
  "name": "ubuntu-shared-browser-agent",
  "version": "1.0.0",
  "description": "Ubuntu shared Chrome agent with Pi SDK backend and side-panel extension",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "test:e2e-live": "USBA_E2E_LIVE=1 vitest run tests/e2e-live.test.ts",
    "test:acceptance": "vitest run && USBA_E2E_PI=1 vitest run tests/e2e-pi-qwen.test.ts tests/e2e-handoff-pi-http.test.ts",
    "test:acceptance:codex": "USBA_E2E_CODEX=1 vitest run tests/e2e-pi-codex.test.ts",
    "test:acceptance:panel": "USBA_E2E_PANEL=1 vitest run tests/e2e-sidepanel.test.ts",
    "icons": "bash scripts/export-icons.sh",
    "install:desktop": "bash scripts/install-icons.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "playwright": "^1.63.0",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
