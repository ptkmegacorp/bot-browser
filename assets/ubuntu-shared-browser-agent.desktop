[Desktop Entry]
Type=Application
Version=1.0
Name=Ubuntu Shared Browser Agent
GenericName=Browser Agent
Comment=Start the Agent Chrome profile and automation backend
Keywords=ubuntu;shared;browser;agent;USBA;chrome;automation;ubuntu-shared-browser-agent;ubuntusharedbrowseragent;UbuntuSharedBrowserAgent;
Exec=@REPO_ROOT@/scripts/launch-usba.sh
Icon=ubuntu-shared-browser-agent
Terminal=false
Categories=Network;Development;
StartupNotify=true
StartupWMClass=UbuntuSharedBrowserAgent
